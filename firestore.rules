rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isOwner(poolId) {
      return request.auth.uid in get(/databases/$(database)/documents/Pools/$(poolId)).data.ownerIds;
    }

    function isParticipant(poolId) {
      // Also allow owners to be considered participants for access purposes
      return request.auth.uid in get(/databases/$(database)/documents/Pools/$(poolId)).data.participantIds || isOwner(poolId);
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // --- Collection Rules ---

    // Rules for the 'Pools' collection
    match /Pools/{poolId} {
      // Anyone authenticated can see the list of pools, but not subcollections by default.
      allow read: if isAuthenticated();
      
      // A user can create a new pool if they list themselves as the owner.
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.ownerIds;
      
      // Only owners of the pool can update or delete it.
      allow update, delete: if isOwner(poolId);

      // --- Subcollection Rules for 'Pools' ---

      // Rules for Participants
      match /Participants/{userId} {
        allow read: if isParticipant(poolId);
        
        // An owner can add a participant, or a user can add themselves.
        allow create: if isOwner(poolId) || request.auth.uid == userId;
        
        // Complex update logic based on roles
        allow update: if 
          // Case 1: A user is updating their own editable fields.
          (request.auth.uid == userId && 
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'timezone'])) ||
          // Case 2: An owner is updating admin-level fields.
          (isOwner(poolId) && 
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isAdmin', 'hasPaid']));
      }

      // Rules for Teams, Groups, and Matches (Admin-only)
      match /{subcollection}/{docId} 
        where subcollection in ['Teams', 'Groups', 'Matches'] {
        
        allow read: if isParticipant(poolId);
        allow create, update, delete: if isOwner(poolId);
      }

      // Rules for Bets (nested under Matches)
      match /Matches/{matchId}/Bets/{participantId} {
        allow read: if isParticipant(poolId);
        
        // A user can create their own bet before the lock time.
        allow create: if request.auth.uid == participantId && request.time < request.resource.data.betLockedTime;
        
        // A user can update their own bet before the lock time.
        // Core fields like IDs cannot be changed.
        allow update: if request.auth.uid == participantId 
                      && request.time < resource.data.betLockedTime
                      && request.resource.data.participantId == resource.data.participantId
                      && request.resource.data.matchId == resource.data.matchId;
                      
        // A user can delete their own bet before the lock time.
        allow delete: if request.auth.uid == participantId && request.time < resource.data.betLockedTime;
      }
    }
  }
}
